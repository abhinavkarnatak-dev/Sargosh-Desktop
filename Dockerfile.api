FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY deploy/api/package.json deploy/api/package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.server.json ./tsconfig.server.json
COPY src/server ./src/server
COPY src/shared ./src/shared
RUN ./node_modules/.bin/tsc -p tsconfig.server.json
RUN npm prune --omit=dev --ignore-scripts

FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production SARGOSH_API_MODE=hosted
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-api ./dist-api
USER node
EXPOSE 10000
CMD ["node","dist-api/server/index.js"]
