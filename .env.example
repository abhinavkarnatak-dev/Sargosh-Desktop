# Provider keys stay in the backend. Copy to private .env and add your own values.
DEEPGRAM_API_KEY=
# Local development bridge. Disabled automatically when NODE_ENV=production.
SARGOSH_LOCAL_TRANSCRIPTION=1

# Optional Gemini cleanup. Never put a real key in this example.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Supabase public project configuration. Real values belong in private .env.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Desktop: set this to the Render HTTPS origin after deployment. Leave unset for local development.
# SARGOSH_API_URL=https://your-service.onrender.com
# Hosted server only: store these in Render Environment, never in the installed app.
# SARGOSH_API_MODE=hosted
# SARGOSH_PUBLIC_API_URL=https://your-service.onrender.com
# SUPABASE_SERVER_KEY=your_server_only_supabase_secret_key
# FFMPEG_PATH=ffmpeg

# Accounting rate only, in microdollars per minute. Confirm the effective Deepgram account tariff.
# SARGOSH_STT_RATE_MICRO_PER_MINUTE=5200
